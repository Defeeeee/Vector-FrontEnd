# Backend endpoints. Every consumer falls back to these exact values in code,
# so the app still works if this file is missing.
NEXT_PUBLIC_AUTH_URL=https://auth.flightlog.fdiaznem.com.ar
NEXT_PUBLIC_API_URL=https://api.flightlog.fdiaznem.com.ar

# Server-only. Las llamadas server-to-server (crons, webhooks, SSR) van por
# http://127.0.0.1:7477 por defecto —el puerto real del backend en el mismo
# VPS— y NEXT_PUBLIC_API_URL no entra en ese default: es para el navegador, que
# no puede alcanzar el localhost del servidor. Sólo hace falta setear API_URL
# acá si el backend deja de estar en la misma máquina, o corre en otro puerto.
# API_URL=http://127.0.0.1:7477

# Gemini, for the AI copilot (chat widget + WhatsApp).
GEMINI_API_KEY=

# Kapso / WhatsApp Business.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Plantillas de WhatsApp aprobadas por Meta para los avisos de vencimiento. Van
# por entorno porque el nombre lo fija la aprobación, no el código: un envío
# proactivo no puede ser texto libre (Meta sólo lo permite dentro de las 24 h
# desde el último mensaje del piloto). Los defaults son los nombres cargados.
WHATSAPP_TEMPLATE_VENCIMIENTO=vencimiento_proximo
WHATSAPP_TEMPLATE_VENCIDO=documento_vencido
WHATSAPP_TEMPLATE_LANG=es_AR

# Shared with the backend's DOCUMENTS_ALERT_SECRET. Guards
# /api/cron/document-alerts and authenticates it against the backend sweep.
# Without it the cron refuses to run.
DOCUMENTS_ALERT_SECRET=

# Resend, para el briefing por mail del vuelo de mañana
# (/api/cron/briefing-vuelos). Sin esta clave el barrido corre, no manda nada y
# lo dice: no es un error, es la feature apagada.
#
# No hace falta verificar un dominio para arrancar: el remitente de prueba de
# Resend entrega al mail del titular de la cuenta, que es este caso. Un dominio
# propio mejora la entregabilidad cuando haya más de un piloto.
RESEND_API_KEY=
RESEND_FROM=

# Dónde vive la app, para armar los links de los mails. Sin esto el briefing
# apunta al dominio de producción por defecto.
NEXT_PUBLIC_APP_URL=https://vector.fdiaznem.com.ar
