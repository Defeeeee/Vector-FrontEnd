{
  "manifest_version": 3,
  "name": "Vector → CAD",
  "short_name": "Vector CAD",
  "version": "1.0.0",
  "description": "Pasá los vuelos de tu bitácora de Vector al CAD de ANAC desde tu propia sesión del CAD. No guarda ni ve tu contraseña.",
  "homepage_url": "https://vector.fdiaznem.com.ar/dashboard/history/cad",
  "icons": {
    "16": "iconos/vector-16.png",
    "32": "iconos/vector-32.png",
    "48": "iconos/vector-48.png",
    "128": "iconos/vector-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cad.anac.gob.ar/foliadoweb/*"],
      "js": ["cad.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vector.fdiaznem.com.ar/*"],
      "js": ["vector.js"],
      "run_at": "document_start"
    }
  ]
}
